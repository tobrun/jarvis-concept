{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/guard.sh", "timeout": 30}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [{"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/capture.sh", "timeout": 30}]
      }
    ]
  },
  "includeCoAuthoredBy": false
}
